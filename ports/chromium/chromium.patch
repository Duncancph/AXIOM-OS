+// On AXIOM (Chromium as a Linux program there: /dev/axiom/window) there are no
+// Unix-domain sockets or symlinks on its FAT disks yet, so Vertex is simply the
+// only instance (a second one isn't routed to the first).
+bool OnAxiom() {
+  static const bool on_axiom = access("/dev/axiom/window", F_OK) == 0;
